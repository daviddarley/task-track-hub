{
  "name": "task-track-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that merges your assigned work from ClickUp, NetSuite and future sources into one popup.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test --test-reporter=spec",
    "typecheck": "tsc --noEmit",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.4.5"
  }
}
