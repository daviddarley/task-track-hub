{
  "manifest_version": 3,
  "name": "Task Track Hub",
  "key": "",
  "version": "0.1.0",
  "description": "Your assigned work from ClickUp (and later NetSuite) merged into one popup.",
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://api.clickup.com/*",
    "https://*.suitetalk.api.netsuite.com/*",
    "https://basecamp.com/*",
    "https://launchpad.37signals.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Task Track Hub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
